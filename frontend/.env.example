BACKEND_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# true: public portfolio-only deployment, hide backend sign-in CTAs
# false (default): full-stack application with real backend sign-in
NEXT_PUBLIC_AQLYRA_DEMO_ONLY=false

# Must remain false until backend CLOUD_UPLOAD_PUBLIC_ENABLED and private
# bucket CORS + lifecycle are independently tested in HTTPS staging.
NEXT_PUBLIC_CLOUD_UPLOAD_ENABLED=false
