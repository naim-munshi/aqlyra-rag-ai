PROJECT_NAME=Aqlyra RAG AI
VERSION=1.0.0
API_V1_STR=/api/v1
APP_ENV=development
BACKEND_ENV_FILE=./backend/.env
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Verified identity
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_SECONDS=60

# Gmail SMTP. Use a Google App Password, never your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_FROM_NAME=Aqlyra
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10

# Google OAuth 2.0 Web Client ID. This is public, not a client secret.
GOOGLE_CLIENT_ID=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aqlyra_rag_ai
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aqlyra_rag_ai
DATABASE_URL_DOCKER=postgresql+psycopg://postgres:postgres@postgres:5432/aqlyra_rag_ai

REDIS_URL=redis://localhost:6379/0
REDIS_URL_DOCKER=redis://redis:6379/0

RATE_LIMIT_ENABLED=false
RATE_LIMIT_CLIENT_IP_HEADER=X-Aqlyra-Client-IP
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=1

RATE_LIMIT_REGISTER_IP_LIMIT=5
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_IP_LIMIT=10
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_IDENTITY_LIMIT=10
RATE_LIMIT_LOGIN_IDENTITY_WINDOW_SECONDS=300
RATE_LIMIT_VERIFY_IP_LIMIT=10
RATE_LIMIT_VERIFY_IP_WINDOW_SECONDS=300
RATE_LIMIT_RESEND_IP_LIMIT=5
RATE_LIMIT_RESEND_IP_WINDOW_SECONDS=3600
RATE_LIMIT_UPLOAD_USER_LIMIT=20
RATE_LIMIT_UPLOAD_USER_WINDOW_SECONDS=3600
RATE_LIMIT_PROCESS_USER_LIMIT=30
RATE_LIMIT_PROCESS_USER_WINDOW_SECONDS=3600
RATE_LIMIT_RAG_USER_LIMIT=20
RATE_LIMIT_RAG_USER_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_USER_LIMIT=30
RATE_LIMIT_CHAT_USER_WINDOW_SECONDS=60
RATE_LIMIT_VOICE_USER_LIMIT=5
RATE_LIMIT_VOICE_USER_WINDOW_SECONDS=60

OPENAI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Realtime voice
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_AGENT_NAME=aqlyra-voice
VOICE_STT_MODEL=whisper-large-v3
VOICE_TTS_MODEL=cartesia/sonic-3.5
VOICE_TTS_VOICE=a5136bf9-224c-4d76-b823-52bd5efcffcc
VOICE_TTS_DEFAULT_LANGUAGE=en

EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=deterministic-sha256-v1
EMBEDDING_DIMENSION=384
EMBEDDING_MAX_BATCH_SIZE=128
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

# deterministic | groq | openai
# Operational alerting
ALERTING_ENABLED=false
ALERT_BACKEND_BASE_URL=http://backend:8000/api/v1
ALERT_POLL_INTERVAL_SECONDS=30
ALERT_STARTUP_GRACE_SECONDS=60
ALERT_READINESS_FAILURES=3
ALERT_RECOVERY_SUCCESSES=2
ALERT_HTTP_TIMEOUT_SECONDS=5
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
ALERT_HTTP_5XX_RATIO_THRESHOLD=0.10
ALERT_HTTP_5XX_MIN_REQUESTS=20
ALERT_P95_LATENCY_SECONDS=3
ALERT_LATENCY_MIN_REQUESTS=20
ALERT_RATE_LIMIT_EXCEEDED_THRESHOLD=50
ALERT_RATE_LIMIT_BACKEND_UNAVAILABLE_THRESHOLD=1
ALERT_UNHANDLED_EXCEPTION_THRESHOLD=1
ALERT_HEARTBEAT_FILE=/tmp/aqlyra-alerting-heartbeat
ALERT_HEARTBEAT_MAX_AGE_SECONDS=180

LLM_PROVIDER=deterministic
LLM_MODEL=gpt-5
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

RAG_GROUNDING_VERIFIER_ENABLED=false
RAG_RERANKER_ENABLED=false
RAG_QUERY_REWRITE_ENABLED=false

# Personal memory extraction
MEMORY_AUTO_EXTRACT_ENABLED=false
MEMORY_EXTRACTION_MAX_CANDIDATES=4

# Personal memory chat context
MEMORY_CHAT_ENABLED=false
MEMORY_CHAT_TOP_K=5
MEMORY_CHAT_MIN_SIMILARITY=0.35

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
UPLOAD_CHUNK_SIZE_BYTES=1048576
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.txt,.md,.csv,.png,.jpg,.jpeg,.webp

LOG_LEVEL=INFO
