BACKEND_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Retired compatibility setting: the public scripted demo is disabled.
# This legacy value is ignored by the current frontend.
NEXT_PUBLIC_AQLYRA_DEMO_ONLY=false

# Enable only when the signed backend Guest API and global Redis quotas
# have passed production tests. Hidden + blocked by default otherwise.
NEXT_PUBLIC_AQLYRA_GUEST_ENABLED=false

# Must remain false until backend CLOUD_UPLOAD_PUBLIC_ENABLED and private
# bucket CORS + lifecycle are independently tested in HTTPS staging.
NEXT_PUBLIC_CLOUD_UPLOAD_ENABLED=false
