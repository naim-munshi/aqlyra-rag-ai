# Aqlyra production environment template.
# Copy to backend/.env.production on the server.
# NEVER commit the real production file.

PROJECT_NAME=Aqlyra RAG AI
VERSION=1.0.0
API_V1_STR=/api/v1

APP_ENV=production
BACKEND_ENV_FILE=./backend/.env.production
DEBUG=false

# Replace with the real HTTPS frontend origin.
CORS_ORIGINS=https://app.example.com

# Generate a strong random value (32+ characters).
SECRET_KEY=replace-with-production-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Production database identity.
POSTGRES_USER=aqlyra
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=aqlyra
POSTGRES_PORT=5432

# Password must be URL encoded when necessary.
DATABASE_URL=postgresql+psycopg://aqlyra:replace-with-url-encoded-password@127.0.0.1:5432/aqlyra
DATABASE_URL_DOCKER=postgresql+psycopg://aqlyra:replace-with-url-encoded-password@postgres:5432/aqlyra

REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
GROQ_API_KEY=replace-with-production-groq-key
HF_TOKEN=replace-with-production-hf-token

LIVEKIT_URL=replace-with-production-livekit-url
LIVEKIT_API_KEY=replace-with-production-livekit-key
LIVEKIT_API_SECRET=replace-with-production-livekit-secret

VOICE_AGENT_NAME=aqlyra-voice
VOICE_STT_MODEL=whisper-large-v3
VOICE_TTS_MODEL=cartesia/sonic-3.5
VOICE_TTS_VOICE=a5136bf9-224c-4d76-b823-52bd5efcffcc
VOICE_TTS_DEFAULT_LANGUAGE=en

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
EMBEDDING_DIMENSION=384
EMBEDDING_MAX_BATCH_SIZE=128
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
